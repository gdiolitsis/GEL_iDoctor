<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="4dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp"
    android:background="@drawable/gel_panel_gold">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GEL DEVICE MONITOR"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="15sp"
            android:singleLine="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_live"
                android:layout_width="96dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="2dp"
                android:paddingTop="0dp"
                android:paddingRight="2dp"
                android:paddingBottom="0dp"
                android:text="● LIVE 3′"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/gel_btn_outline_selector"/>

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="96dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="2dp"
                android:paddingTop="0dp"
                android:paddingRight="2dp"
                android:paddingBottom="0dp"
                android:text="↻ REFRESH"
                android:textColor="#00FF7F"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/gel_btn_neon_outline"/>

        </LinearLayout>

    </LinearLayout>

    <!-- CPU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU  "
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/widget_cpu_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#00FF7F"
            android:textStyle="bold"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- RAM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM  "
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/widget_ram_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#00FF7F"
            android:textStyle="bold"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- BATTERY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/widget_battery_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATTERY  "
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/widget_battery_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#00FF7F"
            android:textStyle="bold"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- THERMAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_thermal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THERMAL  "
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/widget_thermal_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#00FF7F"
            android:textStyle="bold"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- STORAGE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_storage_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STORAGE FREE  "
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/widget_storage_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#00FF7F"
            android:textStyle="bold"
            android:textSize="14sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="end"
        android:text="Updated: --:--"
        android:textColor="#BDBDBD"
        android:textSize="11sp"/>

</LinearLayout>
