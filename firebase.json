{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.!(well-known)",
      "**/.well-known/!(assetlinks.json)",
      "**/node_modules/**"
